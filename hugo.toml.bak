baseURL = 'https://blog.lenhon.com/'
locale = 'zh-CN'
title = "xijiangzhu's Blog"
theme = "PaperMod"

# PaperMod 基础参数
[params]
  defaultTheme = "auto" # auto / light / dark
  disableThemeToggle = false
  hideFooter = false


# ========== 首页个人介绍区域 ==========
[params.homeInfoParams]
  Enable = true
  Title = "xijiangzhu's Blog"
  Content = "记录技术踩坑笔记，分享学习心得✨"
  avatar = "images/avatar.jpg" # 头像可选：图片放到 static/images/avatar.jpg，去掉注释启用

  # 首页简介下方展示文章数量
  ShowPostInHomeInfo = true
  homeInfoPostCount = 5
  
# ========== 主菜单 main ==========
[[menu.main]]
name = "首页"
pageRef = "/"
identifier = "home"
weight = 1

[[menu.main]]
name = "文章"
pageRef = "/posts/"
weight = 2

[[menu.main]]
name = "归档"
pageRef = "/archives/"
weight = 3

[[menu.main]]
name = "分类"
pageRef = "/categories/"
weight = 4

[[menu.main]]
name = "标签"
pageRef = "/tags/"
weight = 5

[[menu.main]]
name = "关于"
pageRef = "/about/"
weight = 6
